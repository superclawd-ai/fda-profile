# Default chart style for the FDA (matplotlib).
font.family: Inter, Noto Sans, DejaVu Sans
font.size: 11
axes.titlesize: 15
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 14
axes.labelsize: 11
axes.labelcolor: 444444
axes.edgecolor: CCCCCC
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: EEEEEE
grid.linewidth: 0.8
xtick.color: 555555
ytick.color: 555555
xtick.major.size: 0
ytick.major.size: 0
legend.frameon: False
legend.fontsize: 10
axes.prop_cycle: cycler('color', ['2457D6', 'F28E2B', '59A14F', 'E15759', '76B7B2', 'B07AA1'])
figure.figsize: 10, 5.6
figure.dpi: 100
savefig.dpi: 200
savefig.bbox: tight
savefig.pad_inches: 0.25
lines.linewidth: 2.4
